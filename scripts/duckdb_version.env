# The DuckDB release this repo builds and tests against -- ONE place for the
# scripts (check_duckdb_pin.sh, check_extension_stamp.sh, smoke_loadable.sh
# source this file).
#
# Moving to a new DuckDB also means editing what cannot source a file:
#   .github/workflows/MainDistributionPipeline.yml  duckdb_version (stable jobs)
#   .github/workflows/Checks.yml                     stock CLI URLs + their sha256
#   the duckdb / extension-ci-tools submodules       git checkout + git add
#   CLAUDE.md / docs/UPDATING.md                     the stated target
DUCKDB_TAG="v1.5.6"
DUCKDB_SHA="069cc9f9b5be802405797faecc284961b07c70ef"
