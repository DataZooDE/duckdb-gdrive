# name: test/sql/gdrive_secret_scope.test
# description: a gdrive secret that exists but matches no path must say so
# group: [gdrive]
#
# IN ITS OWN FILE. The assertion is about which secret DuckDB selects, so any
# other gdrive secret registered earlier in the same file changes the answer --
# in gdrive_secret.test an earlier authorization_code secret matched first and
# the query went off to wait for a browser instead.
#
# SCOPE is DuckDB's path filter; DRIVE_SCOPE is the OAuth scope. Reaching for
# the wrong one scopes the secret to paths beginning with an https:// URL,
# which no gdrive:// path does, so the secret matches nothing at all. The old
# message said "no secret configured", which sent that user off to create a
# second secret that would not have matched either. Found in the 2026-08-02
# real-world drill: the trap was already described in a source comment, but
# nothing told the person who fell into it.
#
# Credential-free: no token is ever minted, because no secret is ever selected.

require gdrive

statement ok
CREATE SECRET gdrive_wrong_scope (
    TYPE gdrive, PROVIDER config,
    CLIENT_ID 'x', CLIENT_SECRET 'y', REFRESH_TOKEN 'z',
    SCOPE 'https://www.googleapis.com/auth/drive'
);

statement error
SELECT count(*) FROM read_csv('gdrive://fixtures/small.csv');
----
a gdrive secret exists, but none of them apply

# ...and it names the parameter that was actually wanted.
statement error
SELECT count(*) FROM read_csv('gdrive://fixtures/small.csv');
----
DRIVE_SCOPE

# A secret whose SCOPE genuinely covers gdrive:// still matches, so the new
# branch cannot swallow a working configuration.
statement ok
CREATE SECRET gdrive_right_scope (
    TYPE gdrive, PROVIDER config, ACCESS_TOKEN 'bogus',
    SCOPE 'gdrive://'
);

statement error
SELECT count(*) FROM read_csv('gdrive://fixtures/small.csv');
----
authentication failed
