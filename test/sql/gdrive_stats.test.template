# name: test/sql/gdrive_stats.test.template
# description: S-2.9 / S-4.1 / R-1 -- the path cache measurably bounds
#              metadata amplification, and gdrive_stats() reports it
# group: [live]
#
# This lives in its OWN file on purpose. The counters and the path cache are
# process-wide, and scripts/run_live_tests.sh gives each file its own
# unittest process -- so the measurement below starts genuinely cold. Folded
# into gdrive_read.test, the same four reads cost ZERO files.list calls
# because earlier statements there had already resolved those paths. True,
# but it measures the cache warming up rather than the amplification the
# cache exists to bound.

require gdrive

require parquet

require-env GDRIVE_CI_DRIVE_ID

require-env GDRIVE_CI_SA_KEY_FILE

statement ok
CREATE SECRET gdrive_stats_test (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '${SA_KEY_FILE}',
    ROOT_FOLDER_ID '${DRIVE_ID}',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive.readonly'
);

statement ok
CALL gdrive_reset_stats();

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_list'
----
0

# ---------------------------------------------------------------------------
# Four sibling files under fixtures/parts/. Drive has no path addressing, so
# each path costs one files.list per segment:
#
#   uncached: 4 files x 3 segments         = 12 files.list
#   cached:   2 folder segments + 4 leaves =  6 files.list
#
# The README states this as "ten files in one folder cost one folder lookup
# rather than ten". This is that sentence, measured.
#
# The number is asserted EXACTLY. An inequality (< 12) would still pass if
# the cache degraded to caching only the first segment, which gives most of
# the amplification back. If a legitimate change moves this number, move it
# here deliberately and say why in the commit.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_parquet('gdrive://fixtures/parts/part-00.parquet')
----
10

query I
SELECT count(*) FROM read_parquet('gdrive://fixtures/parts/part-01.parquet')
----
10

query I
SELECT count(*) FROM read_parquet('gdrive://fixtures/parts/part-02.parquet')
----
10

query I
SELECT count(*) FROM read_parquet('gdrive://fixtures/parts/part-03.parquet')
----
10

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_list'
----
6

# The cache is doing the work, not merely present.
query I
SELECT value > 0 FROM gdrive_stats() WHERE metric = 'cache_hits'
----
true

# Re-reading a file already resolved in this session costs NO further
# resolution at all -- the steady state the cache is for.
statement ok
CALL gdrive_reset_stats();

query I
SELECT count(*) FROM read_parquet('gdrive://fixtures/parts/part-00.parquet')
----
10

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_list'
----
0

# The id: form skips resolution entirely -- the documented fast path.
statement ok
CALL gdrive_reset_stats();

query I
SELECT count(*) FROM read_csv('gdrive://id:${ID:small.csv}')
----
5

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_list'
----
0

# ---------------------------------------------------------------------------
# REQ-NF-01 premise -- reads are RANGED, not whole-file.
#
# The README says "Reads are ranged, so a Parquet scan fetches footers and
# column chunks rather than whole files". That is the reason a 87 MB fixture
# can be counted in well under a second, and it was untested.
#
# The discriminator is the SHAPE of the traffic, not the timing:
#
#   count(*)            -> the Parquet footer alone answers it   -> 1 call
#   scan of one column  -> footer plus that column's chunks      -> many calls
#
# If the implementation ever degraded to downloading whole files, BOTH would
# be exactly 1 -- so asserting that the column scan issues more than one call
# is what makes this meaningful. An assertion of "fast enough" would not be:
# it would pass on a whole-file download over a good connection.
# ---------------------------------------------------------------------------
statement ok
CALL gdrive_reset_stats();

query I
SELECT count(*) FROM read_parquet('gdrive://fixtures/wide.parquet')
----
2000000

# The footer answers count(*). One ranged GET, not 87 MB.
query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_media'
----
1

statement ok
CALL gdrive_reset_stats();

query I
SELECT count(DISTINCT s1) FROM read_parquet('gdrive://fixtures/wide.parquet')
----
2000000

# Reading actual column data takes several ranged requests -- the column's
# chunks. A whole-file implementation would report 1 here.
query I
SELECT value > 1 FROM gdrive_stats() WHERE metric = 'files_media'
----
true

# ---------------------------------------------------------------------------
# REQ-F-07 -- what an export actually costs.
#
# A native file has no byte stream, so it is fetched whole through
# files.export. The buffer lives on the FILE HANDLE, which means it is reused
# for the rest of one read and NOT between queries.
#
# The README used to say exports were "fetched once and cached", which reads
# like cross-query caching. They are not: two reads cost two exports. Pinned
# here so the documentation and the behaviour cannot drift apart again, and
# so that adding a cross-query cache later is a deliberate change to this
# number rather than an accident.
#
# This is a real quota consideration -- unlike a Parquet read, an export has
# no footer-only shortcut, so every query pays for the whole file.
# ---------------------------------------------------------------------------
statement ok
CALL gdrive_reset_stats();

query I
SELECT count(*) FROM read_csv('gdrive://fixtures/Budget')
----
3

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_export'
----
1

query I
SELECT count(*) FROM read_csv('gdrive://fixtures/Budget')
----
3

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_export'
----
2

# ---------------------------------------------------------------------------
# S-2.11 -- the path cache is BOUNDED.
#
# It maps path -> file id and, until this test, grew forever: entries were
# only ever removed by explicit invalidation. A query tool restarts often
# enough that nobody noticed, but a long-lived process globbing many folders
# has an unbounded map in it, and the plan called for eviction from the start.
#
# The bound is asserted by SETTING it small and then resolving far more paths
# than that. Asserting on a default-sized cache would prove nothing -- it
# would pass whether eviction worked or not, because the default is never
# reached in a test.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_path_cache_entries = 8;

statement ok
SELECT count(*) FROM read_csv('gdrive://fixtures/many/f-0*.csv');

query I
SELECT value <= 8 FROM gdrive_stats() WHERE metric = 'path_cache_entries'
----
true

# ...and the cache is still USEFUL at that size: a re-read of a path just
# resolved must not have been evicted out from under itself mid-query.
statement ok
SET gdrive_path_cache_entries = 1024;

# ---------------------------------------------------------------------------
# The per-open metadata refresh is skipped when it CANNOT return anything new.
#
# OpenFile used to always issue one files.get to confirm size and
# headRevisionId. Measured at ~270 ms (docs/paper Figure 1), paid once per file
# per query. Two cases where it is provably redundant:
#
#   1. The leaf was resolved by a files.list in THIS query. That listing's
#      field mask already returns size and headRevisionId, so the refresh is a
#      round trip that cannot differ. Always on.
#   2. The user declared the path immutable. A cached leaf cannot be stale
#      either, because staleness needs an in-place overwrite. Opt-in.
#
# Exact equalities, not `<=`. `files_get <= 1` would pass whether the skip
# fired or not, which is the whole thing being tested here.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_immutable_prefixes = '';

statement ok
SELECT * FROM gdrive_reset_stats();

# Case 1: cold. The glob/resolve lists the leaf, so the open needs no files.get
# at all. This is the pure win -- it changes no semantics and has no setting.
statement ok
SELECT count(*) FROM read_parquet('gdrive://fixtures/wide.parquet');

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_get'
----
0

# Case 2: a SECOND query. The path cache now carries the leaf from the previous
# query, which CAN be stale, so the refresh must come back. Exactly one -- the
# per-query metadata cache still collapses the per-thread opens into one.
statement ok
SELECT * FROM gdrive_reset_stats();

statement ok
SELECT count(*) FROM read_parquet('gdrive://fixtures/wide.parquet');

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_get'
----
1

# Case 3: same second query, but the prefix is declared immutable. Now the
# refresh is skipped too.
statement ok
SET gdrive_immutable_prefixes = 'gdrive://fixtures';

statement ok
SELECT * FROM gdrive_reset_stats();

statement ok
SELECT count(*) FROM read_parquet('gdrive://fixtures/wide.parquet');

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_get'
----
0

# Case 4: the prefix match is on SEGMENTS. 'gdrive://fix' must not exempt
# 'gdrive://fixtures/...'. A plain starts_with would, and would silently
# suppress freshness checks for every sibling directory sharing a name prefix.
statement ok
SET gdrive_immutable_prefixes = 'gdrive://fix';

statement ok
SELECT * FROM gdrive_reset_stats();

statement ok
SELECT count(*) FROM read_parquet('gdrive://fixtures/wide.parquet');

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_get'
----
1

statement ok
SET gdrive_immutable_prefixes = '';

# ---------------------------------------------------------------------------
# O-1: a glob must CACHE the children it already listed.
#
# Glob lists a folder, matches locally, and returns. It used to discard the
# listing, so every subsequent OpenFile re-resolved its leaf with a fresh
# files.list -- 151 listings to read 150 files, when every one of those leaves
# was in the first response, complete with size and headRevisionId.
#
# Exactly 1: the single ListChildren of `fixtures/many`. An inequality would
# pass at 151 and prove nothing.
#
# The literal prefix is resolved deliberately first, so this assertion is about
# the GLOB and not about whichever earlier case in this file happened to leave
# `fixtures/many` in the path cache. Without that the expected number depends
# on test ordering, which is not a property anybody should have to reason about
# when this fails.
# ---------------------------------------------------------------------------
statement ok
SELECT count(*) FROM glob('gdrive://fixtures/many/f-000.csv');

statement ok
SELECT * FROM gdrive_reset_stats();

query I
SELECT count(*) FROM read_csv('gdrive://fixtures/many/*.csv')
----
150

query I
SELECT value FROM gdrive_stats() WHERE metric = 'files_list'
----
1

# The `count(*) = 150` above is the guard that no file was dropped -- caching
# resolution must not lose a match. Deliberately NOT asserted via files_media:
# an earlier case in this file reads f-0*.csv, so 100 of these files already
# have their blocks cached and the media count here is 50, not 150. That is a
# property of test ordering, not of this change.
