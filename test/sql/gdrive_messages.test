# name: test/sql/gdrive_messages.test
# description: errors say what to fix -- no network needed (exploratory testing, 2026-11-07)
# group: [gdrive]

require gdrive

# No secret: every function gives the same advice, leading with the
# argument-less default (D-10).
statement error
SELECT * FROM search_gdrive('x')
----
CREATE SECRET (TYPE gdrive); uses your gcloud login

statement error
SELECT * FROM read_gdrive_files('gdrive://x/*.csv')
----
CREATE SECRET (TYPE gdrive); uses your gcloud login

# Two root bindings are two different things, not one setting twice.
statement error
CREATE SECRET two (TYPE gdrive, PROVIDER config, ACCESS_TOKEN 'x', DRIVE_ID '0Aabc', ROOT_FOLDER_ID '1abc')
----
not both

# The Docs export format is checked when it is set, not ignored when used.
statement error
SET gdrive_docs_export_mime = 'application/x-bogus'
----
is not a format Drive exports a Doc to

statement ok
SET gdrive_docs_export_mime = 'application/pdf'

statement ok
SET gdrive_docs_export_mime = 'text/plain'
