# name: test/sql/gdrive_credential_chain_live.test.template
# description: B-2 -- PROVIDER credential_chain against REAL Google Drive.
# group: [live]
#
# Materialised into test/sql/live/gdrive_credential_chain_live.test by
# e2e/helpers/materialise.py. Run via `make test_live`.
#
# There is no fake and no replay (decision D-1): every statement below is a
# real HTTPS round trip, and the tokens are minted by real calls to Google's
# token endpoint.
#
# Covers BOTH arms of the chain, because they take different code paths to a
# token and only one of them is shared with another provider:
#
#   service_account  -> RFC 7523 assertion, minted here. This is the arm
#                       google-cloud-cpp gets wrong for Drive (it self-signs a
#                       JWT, which Drive rejects with 401 -- see gdrive_adc.hpp),
#                       so it is the arm most worth pinning.
#   authorized_user  -> refresh_token exchange, shared with PROVIDER config.

require gdrive

require parquet

require-env GDRIVE_CI_DRIVE_ID

require-env GDRIVE_CI_SA_KEY_FILE

# ---------------------------------------------------------------------------
# B-2 -- the service-account arm. GOOGLE_APPLICATION_CREDENTIALS is the
# variable Google's own libraries honour first and the one CI sets; here it is
# supplied through gdrive_adc_file, which outranks it, so the test does not
# depend on the environment of the process running it.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_adc_file = '${SA_KEY_FILE}';

statement ok
CREATE SECRET gdrive_chain_sa (
    TYPE gdrive,
    PROVIDER credential_chain,
    ROOT_FOLDER_ID '${DRIVE_ID}',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive'
);

query III
SELECT id, name, amount FROM read_csv('gdrive://fixtures/small.csv') ORDER BY id
----
1	row-1	100
2	row-2	200
3	row-3	300
4	row-4	400
5	row-5	500

# A second read must not re-mint: the token cache is keyed by the resolved
# source, and a cache miss here would mean every request pays a token round
# trip (REQ-NF-02).
query I
SELECT count(*) FROM read_csv('gdrive://fixtures/small.csv')
----
5

statement ok
DROP SECRET gdrive_chain_sa;

# ---------------------------------------------------------------------------
# B-1 -- an ADC path that does not exist produces the teaching message, not a
# bare 401 from Google. Asserted live as well as offline because the offline
# test cannot prove the failure happens BEFORE any HTTP request is made.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_adc_file = '/nonexistent/gdrive-live/application_default_credentials.json';

statement ok
CREATE SECRET gdrive_chain_none (
    TYPE gdrive,
    PROVIDER credential_chain,
    ROOT_FOLDER_ID '${DRIVE_ID}'
);

statement error
SELECT count(*) FROM read_csv('gdrive://fixtures/small.csv')
----
gcloud auth application-default login

statement ok
DROP SECRET gdrive_chain_none;

statement ok
RESET gdrive_adc_file;
