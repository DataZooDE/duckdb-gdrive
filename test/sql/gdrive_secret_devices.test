# name: test/sql/gdrive_secret_devices.test
# description: a KEY_FILE that is a device is refused, never read (/dev/zero
#              would stream forever). POSIX only: Windows has no /dev/zero.
# group: [sql]

require gdrive

require notwindows

statement error
CREATE SECRET gd_devzero (TYPE gdrive, PROVIDER service_account, KEY_FILE '/dev/zero');
----
not a regular file
