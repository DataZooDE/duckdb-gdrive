# name: test/sql/gdrive_write.test.template
# description: S-3.1..S-3.13 -- export, write and mutation against REAL Drive
# group: [live]
#
# Materialised by e2e/helpers/materialise.py. Run via `make test_live`.
# Every mutating statement targets a per-run scratch folder so concurrent CI
# runs cannot collide.

require gdrive

require parquet

require-env GDRIVE_CI_DRIVE_ID

require-env GDRIVE_OAUTH_CLIENT_ID

require-env GDRIVE_OAUTH_CLIENT_SECRET

require-env GDRIVE_USER_REFRESH_TOKEN

# PROVIDER config with a refresh token, NOT service_account: a service
# account has no Drive storage quota and cannot write outside a Shared Drive
# (403 storageQuotaExceeded, verified live 2026-07-26). Writing needs a
# delegated user, so this secret mints and refreshes its own access token via
# grant_type=refresh_token against Google's token endpoint -- see
# src/gdrive_auth.cpp's BuildContextFromConfig. Real credential values are
# never in this template: they are substituted from the environment at
# materialisation time (e2e/helpers/materialise.py), and the materialised
# file lives in the gitignored test/sql/live/.
statement ok
CREATE SECRET gdrive_test (
    TYPE gdrive,
    PROVIDER config,
    CLIENT_ID '${OAUTH_CLIENT_ID}',
    CLIENT_SECRET '${OAUTH_CLIENT_SECRET}',
    REFRESH_TOKEN '${USER_REFRESH_TOKEN}',
    ROOT_FOLDER_ID '${DRIVE_ID}',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive'
);

# ---------------------------------------------------------------------------
# S-3.2 -- REQ-F-07 / BRD success criterion 3: a native Google Sheet is
# queryable with no manual export. A Sheet has NO byte stream, so alt=media
# fails on it and files.export is the only way through.
# ---------------------------------------------------------------------------
query II
SELECT quarter, revenue FROM read_csv('gdrive://fixtures/Budget') ORDER BY quarter
----
Q1	1000
Q2	2000
Q3	3000

# S-3.3 -- GetFileSize on a native file must report the EXPORTED length.
# Drive reports no `size` at all for these, so a naive implementation returns
# 0 or -1 and every read comes back empty.
query I
SELECT count(*) > 0 FROM read_csv('gdrive://fixtures/Budget')
----
true

# S-3.4 -- a Doc exports as text/plain by default (D-7: byte-stable, so
# GetVersionTag-keyed caching stays honest).
query I
SELECT count(*) > 0 FROM read_text('gdrive://fixtures/Notes')
----
true

# ---------------------------------------------------------------------------
# S-3.5 / S-3.7 -- write round trip. COPY emits a whole file, which is exactly
# what the buffered-upload-on-close design suits.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 1 AS a, 'x' AS b) TO 'gdrive://scratch/${SCRATCH}/out.csv' (FORMAT csv, HEADER);

query II
SELECT a, b FROM read_csv('gdrive://scratch/${SCRATCH}/out.csv')
----
1	x

statement ok
COPY (SELECT i, i*2 AS d FROM range(1000) t(i)) TO 'gdrive://scratch/${SCRATCH}/out.parquet' (FORMAT parquet);

query I
SELECT count(*) FROM read_parquet('gdrive://scratch/${SCRATCH}/out.parquet')
----
1000

query I
SELECT sum(d) FROM read_parquet('gdrive://scratch/${SCRATCH}/out.parquet')
----
999000

# ---------------------------------------------------------------------------
# S-3.9 -- overwriting an existing name must files.update the resolved id,
# NOT create a second file with the same name. Creating a duplicate would
# manufacture exactly the R-4 collision the resolver then refuses to read.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 2 AS a, 'y' AS b) TO 'gdrive://scratch/${SCRATCH}/out.csv' (FORMAT csv, HEADER);

query II
SELECT a, b FROM read_csv('gdrive://scratch/${SCRATCH}/out.csv')
----
2	y

query I
SELECT count(*) FROM glob('gdrive://scratch/${SCRATCH}/out.csv')
----
1

# ---------------------------------------------------------------------------
# S-3.10 -- deletion semantics (D-6) are tested in
# e2e/tests/test_delete_semantics.py, NOT here.
#
# This block used to be titled "RemoveFile trashes by default", create a file
# called doomed.csv, assert it existed, and delete nothing. A test named for
# a behaviour it does not exercise is worse than no test: it makes the
# coverage report lie, and it did for as long as it existed.
#
# It cannot be done in SQL for two reasons: there is no SQL function that
# removes a file (RemoveFile is reached through DuckDB internals -- in
# practice by OVERWRITING a path), and "trashed" versus "permanently gone" is
# invisible from SQL because both look like absence. Only Drive's own
# metadata distinguishes them, which needs the harness.
#
# What remains here is the plain fact that a written file is visible, which
# is worth asserting and is all this ever actually asserted.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 1 AS a) TO 'gdrive://scratch/${SCRATCH}/written.csv' (FORMAT csv);

query I
SELECT count(*) FROM glob('gdrive://scratch/${SCRATCH}/written.csv')
----
1

# ---------------------------------------------------------------------------
# S-3.12 -- directories are files with a folder mimeType.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT 1 AS a) TO 'gdrive://scratch/${SCRATCH}/sub/nested.csv' (FORMAT csv);

query I
SELECT count(*) FROM read_csv('gdrive://scratch/${SCRATCH}/sub/nested.csv')
----
1

# ---------------------------------------------------------------------------
# S-4.3 / BRD success criterion 4 (R-2) -- a QUOTA error must be distinct and
# actionable, live, not just in the pure classifier.
#
# The rate-limit half of R-2 cannot be provoked responsibly: exhausting Drive
# API quota needs a throwaway Google project, and doing it against a real one
# degrades that account's Drive for everyone using it. The plan (S-4.3)
# anticipates this and accepts the captured 403/429 bodies in
# test/cpp/test_errors.cpp as the assertion for that half. Documented in
# docs/benchmark.md and the README as a known coverage gap -- stated, not
# hidden.
#
# The STORAGE-quota half, though, is free to provoke and worth having: a
# service account has NO Drive storage quota, so it cannot create a byte
# outside a Shared Drive. Our fixture root is an ordinary folder, so this
# write returns a real 403 storageQuotaExceeded from the live API. That makes
# the whole path real -- Drive's body, our classifier, DuckDB's exception.
#
# Note the failure mode this guards: folder CREATION succeeds for a service
# account (folders consume no quota), so the error only appears when the
# first byte is written. It looks exactly like a permissions problem until
# then, which is why the message must say "storage quota" and must NOT be
# phrased as a retryable rate limit.
require-env GDRIVE_CI_SA_KEY_FILE

# Drop the delegated-user secret FIRST. With two gdrive secrets live, both
# match every gdrive:// path and which one wins is DuckDB's scope-resolution
# order, not ours -- the write could quietly succeed as the user and this
# test would assert nothing. This block is last in the file for that reason.
statement ok
DROP SECRET gdrive_test;

# ---------------------------------------------------------------------------
# REQ-NF-04 -- least privilege BY DEFAULT, and proof that it is enforced
# rather than decorative.
#
# Omitting DRIVE_SCOPE must request drive.readonly. For a service account
# that is testable end to end, because the scope claim in the RFC 7523
# assertion is enforced by Google: a write with the default scope is refused
# for INSUFFICIENT SCOPES, before quota is ever considered.
#
# The contrast immediately below is what makes this meaningful. The same
# write, from the same identity, with an explicit full scope, gets a
# DIFFERENT error -- storage quota. If the default were silently full access,
# both would report quota and this test would prove nothing.
# ---------------------------------------------------------------------------
statement ok
CREATE OR REPLACE SECRET gdrive_sa_default_scope (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '${SA_KEY_FILE}',
    ROOT_FOLDER_ID '${DRIVE_ID}'
);

# Reading is what drive.readonly is for, so this must still work.
query I
SELECT count(*) FROM read_csv('gdrive://fixtures/small.csv')
----
5

statement error
COPY (SELECT 1 AS a) TO 'gdrive://scratch/${SCRATCH}/default-scope.csv' (FORMAT csv);
----
insufficient authentication scopes

statement ok
DROP SECRET gdrive_sa_default_scope;

statement ok
CREATE SECRET gdrive_sa_noquota (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '${SA_KEY_FILE}',
    ROOT_FOLDER_ID '${DRIVE_ID}',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive'
);

# The expected text is deliberately specific. A bare "quota" would also match
# a rate-limit message, which is the exact confusion R-2 exists to prevent --
# the test would then pass on the failure it is meant to catch.
statement error
COPY (SELECT 1 AS a) TO 'gdrive://scratch/${SCRATCH}/sa-quota-probe.csv' (FORMAT csv);
----
Drive storage quota exceeded

# ...and the cause is named, not just the symptom. A user hitting this needs
# to be told to use a Shared Drive; "quota exceeded" alone sends them looking
# at billing.
statement error
COPY (SELECT 2 AS a) TO 'gdrive://scratch/${SCRATCH}/sa-quota-probe-2.csv' (FORMAT csv);
----
service accounts do not have storage quota outside a Shared Drive
