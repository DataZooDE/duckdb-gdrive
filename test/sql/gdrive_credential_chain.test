# name: test/sql/gdrive_credential_chain.test
# description: B-1 -- PROVIDER credential_chain registration and its
# discovery/error surface. Needs no credentials and no network: creating the
# secret stores no credential material (it is a marker; resolution happens on
# first use), and the failure path is provoked by pointing CLOUDSDK_CONFIG at
# a directory with no ADC file in it. Reading through a resolved credential
# is covered by test/sql/live/, which needs both.
# group: [sql]

require gdrive

# ---------------------------------------------------------------------------
# B-1 -- the provider registers, and takes no credential arguments at all.
# That is the whole point: a user who has run `gcloud auth
# application-default login` types one statement and nothing else.
# ---------------------------------------------------------------------------
statement ok
CREATE SECRET gdrive_chain (TYPE gdrive, PROVIDER credential_chain);

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'gdrive_chain'
----
credential_chain

query I
SELECT type FROM duckdb_secrets() WHERE name = 'gdrive_chain'
----
gdrive

# The root binding still applies -- credential_chain says where the identity
# comes from, not which Drive it addresses.
statement ok
CREATE SECRET gdrive_chain_scoped (
    TYPE gdrive,
    PROVIDER credential_chain,
    DRIVE_ID '0ABcDeFgHiJkLmNoPQ',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive'
);

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'gdrive_chain_scoped'
----
1

# ---------------------------------------------------------------------------
# B-4 -- credential_chain is the DEFAULT provider, so the bare form works.
# ---------------------------------------------------------------------------
statement ok
CREATE SECRET gdrive_default (TYPE gdrive);

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'gdrive_default'
----
credential_chain

statement ok
DROP SECRET gdrive_default;

statement ok
DROP SECRET gdrive_chain_scoped;

statement ok
DROP SECRET gdrive_chain;

# ---------------------------------------------------------------------------
# B-1 -- when nothing resolves, the error must teach the fix rather than
# report a failure.
#
# gdrive_adc_file outranks the environment, so pointing it at a path that
# cannot exist provokes this deterministically -- on a developer machine with
# a real gcloud login, and on a CI runner with none.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_adc_file = '/nonexistent/gdrive-test/application_default_credentials.json';

statement ok
CREATE SECRET gdrive_chain_missing (TYPE gdrive, PROVIDER credential_chain);

# The exact gcloud invocation...
statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
gcloud auth application-default login

# ...the --scopes value, without which every read fails with a 403 that reads
# like a permissions problem (verified against the real API 2026-07-31)...
statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
https://www.googleapis.com/auth/drive

# ...and the path actually consulted, so the reader can check it with `ls`.
statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
/nonexistent/gdrive-test/application_default_credentials.json

statement ok
DROP SECRET gdrive_chain_missing;

# ---------------------------------------------------------------------------
# B-1 -- a file that exists but is the WRONG KIND of document gets its own
# message. Downloading an OAuth client JSON from the Cloud Console and
# pointing ADC at it is a common mistake, and "missing client_id" would be a
# misleading way to report it.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_adc_file = '__TEST_DIR__/oauth_client.json';

statement ok
COPY (SELECT '{"installed": {"client_id": "x.apps.googleusercontent.com"}}' AS j)
     TO '__TEST_DIR__/oauth_client.json' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE SECRET gdrive_chain_wrongdoc (TYPE gdrive, PROVIDER credential_chain);

statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
OAuth client JSON

statement ok
DROP SECRET gdrive_chain_wrongdoc;

statement ok
RESET gdrive_adc_file;

# ---------------------------------------------------------------------------
# An authorized_user credential that names NO QUOTA PROJECT must be refused
# here, before a token is minted and long before a Drive call.
#
# Drive rejects such a credential outright, and its message -- "the
# drive.googleapis.com API requires a quota project, which is not set by
# default" -- arrives attached to whatever query the user happened to run. It
# then reads as a problem with that query or that file, rather than with a
# credential a gcloud command wrote days earlier. Found by review during the
# 2026-08-02 real-world drill; the fix is to name the file and the command.
#
# Credential-free: the point is that this fails before any network access.
# ---------------------------------------------------------------------------
statement ok
SET gdrive_adc_file = '__TEST_DIR__/adc_noquota.json';

statement ok
COPY (SELECT '{"type":"authorized_user","client_id":"x.apps.googleusercontent.com","client_secret":"s","refresh_token":"r"}' AS j)
     TO '__TEST_DIR__/adc_noquota.json' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE SECRET gdrive_chain_noquota (TYPE gdrive, PROVIDER credential_chain);

statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
name no quota project

# The message must tell the reader what to run, not merely what is wrong.
statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
set-quota-project

statement ok
DROP SECRET gdrive_chain_noquota;

# A SERVICE ACCOUNT must not be caught by this check: it carries its own
# project association, and sending it an x-goog-user-project it has no
# serviceusage permission on turns a working call into a 403. Reaching the
# token endpoint (and failing there, on a fake key) proves the quota check
# let it through.
statement ok
SET gdrive_adc_file = '__TEST_DIR__/adc_sa.json';

statement ok
COPY (SELECT '{"type":"service_account","client_email":"x@y.iam.gserviceaccount.com","private_key_id":"k","private_key":"not-a-key","token_uri":"https://oauth2.googleapis.com/token"}' AS j)
     TO '__TEST_DIR__/adc_sa.json' (FORMAT csv, HEADER false, QUOTE '');

statement ok
CREATE SECRET gdrive_chain_sa_noquota (TYPE gdrive, PROVIDER credential_chain);

statement error
SELECT count(*) FROM read_csv('gdrive://does-not-matter.csv');
----
private_key

statement ok
DROP SECRET gdrive_chain_sa_noquota;
