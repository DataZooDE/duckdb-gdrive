# name: test/sql/gdrive_vfs_no_secret.test
# description: a missing secret is a CONFIGURATION error, never "no such file"
# group: [gdrive]
#
# No credentials needed, deliberately: the whole point is that these calls must
# fail before any network access.
#
# Found by real-world drill 2026-08-02. write_blob and move_file threw, but
# file_size returned NULL and remove_file returned false -- reporting an
# unconfigured extension as an absent file. A user with a typo in their secret
# name would be told their data does not exist, and a retry loop built on
# remove_file would report "nothing to delete" forever.
#
# The cause was that both used FileSystem::FileExists as their existence
# oracle, and GDriveFileSystem::FileExists deliberately returns false when no
# secret is configured -- it must, because DuckDB core probes speculatively
# during replacement-scan binding and would break if that threw. The leniency
# is right for core and wrong as a user-facing contract; the functions now
# confirm absence with an explicit NULL_IF_NOT_EXISTS open.
#
# Matching on "secret configured for" rather than the whole sentence: two
# layers phrase this differently -- the write path adds a worked CREATE SECRET
# example, the read guard does not -- and pinning either exactly would make
# this test a hostage to whichever one a future change touches.

require gdrive

statement error
SELECT file_size('gdrive://anything/at/all.parquet');
----
secret configured for

statement error
SELECT remove_file('gdrive://anything/at/all.parquet');
----
secret configured for

statement error
SELECT write_blob('gdrive://anything/at/all.parquet', 'x'::BLOB);
----
secret configured for

statement error
SELECT move_file('gdrive://a/b.txt', 'gdrive://a/c.txt');
----
secret configured for

# glob has always been loud about this (REQ-F-08 / R-2). Pinned here so the
# four functions above stay consistent with it.
statement error
SELECT * FROM glob('gdrive://anything/*.parquet');
----
secret configured for
