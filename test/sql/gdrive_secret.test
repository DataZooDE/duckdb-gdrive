# name: test/sql/gdrive_secret.test
# description: S-1.1 / S-1.2 / S-1.8 -- the `gdrive` secret type, its config
# provider, redaction (REQ-NF-03) and service_account key-file error paths.
# Needs no credentials and no network: PROVIDER config just stores a token
# the caller already has, and the service_account error paths are triggered
# by a KEY_FILE that is deliberately missing/malformed on disk.
# group: [sql]

require gdrive

# ---------------------------------------------------------------------------
# S-1.1 -- the secret type + config provider register successfully.
# ---------------------------------------------------------------------------
statement ok
CREATE SECRET gdrive_tok (
    TYPE gdrive,
    PROVIDER config,
    ACCESS_TOKEN 'super-secret-access-token-value',
    REFRESH_TOKEN 'super-secret-refresh-token-value',
    CLIENT_ID 'my-client-id',
    CLIENT_SECRET 'super-secret-client-secret-value'
);

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'gdrive_tok'
----
1

query I
SELECT type FROM duckdb_secrets() WHERE name = 'gdrive_tok'
----
gdrive

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'gdrive_tok'
----
config

# ---------------------------------------------------------------------------
# S-1.2 / REQ-NF-03 -- duckdb_secrets() must never leak the token, the
# refresh token, or the client secret. secret_string is redacted by default;
# assert none of the three secret values survive into it.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_tok' AND secret_string LIKE '%super-secret-access-token-value%'
----
0

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_tok' AND secret_string LIKE '%super-secret-refresh-token-value%'
----
0

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_tok' AND secret_string LIKE '%super-secret-client-secret-value%'
----
0

# The non-sensitive client_id is not redacted -- redaction is targeted, not
# a blanket wipe of the whole secret.
query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_tok' AND secret_string LIKE '%my-client-id%'
----
1

# ---------------------------------------------------------------------------
# REQ-NF-04 -- scope defaults to the narrowest when unspecified.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_tok' AND secret_string LIKE '%drive.readonly%'
----
1

# ---------------------------------------------------------------------------
# S-1.1 -- config provider needs at least one token; a bare CREATE SECRET
# with nothing usable is a fail-loud configuration error naming the fix.
# ---------------------------------------------------------------------------
statement error
CREATE SECRET gdrive_empty (TYPE gdrive, PROVIDER config);
----
ACCESS_TOKEN

# ---------------------------------------------------------------------------
# Token-refresh slice -- PROVIDER config mints an access token from
# REFRESH_TOKEN/CLIENT_ID/CLIENT_SECRET when no ACCESS_TOKEN is given
# (src/gdrive_auth.cpp's BuildContextFromConfig). A REFRESH_TOKEN with no
# CLIENT_ID/CLIENT_SECRET cannot ever be used to mint anything -- Google's
# grant_type=refresh_token POST needs all three -- so this is caught at
# CREATE SECRET time (no network needed) rather than surfacing as a confusing
# 401 on first use.
# ---------------------------------------------------------------------------
statement error
CREATE SECRET gdrive_refresh_incomplete (
    TYPE gdrive,
    PROVIDER config,
    REFRESH_TOKEN 'some-refresh-token'
);
----
CLIENT_ID

statement error
CREATE SECRET gdrive_refresh_incomplete2 (
    TYPE gdrive,
    PROVIDER config,
    REFRESH_TOKEN 'some-refresh-token',
    CLIENT_ID 'some-client-id'
);
----
CLIENT_SECRET

# A REFRESH_TOKEN with all three of CLIENT_ID/CLIENT_SECRET is accepted at
# CREATE SECRET time -- minting only happens lazily on first gdrive:// access,
# never here, so this needs no network and cannot fail on bogus values.
statement ok
CREATE SECRET gdrive_refresh_complete (
    TYPE gdrive,
    PROVIDER config,
    CLIENT_ID 'some-client-id',
    CLIENT_SECRET 'super-secret-client-secret-for-refresh',
    REFRESH_TOKEN 'super-secret-refresh-token-for-refresh'
);

# REQ-NF-03: refresh_token and client_secret stay redacted for this form too.
query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_refresh_complete' AND secret_string LIKE '%super-secret-refresh-token-for-refresh%'
----
0

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_refresh_complete' AND secret_string LIKE '%super-secret-client-secret-for-refresh%'
----
0

# ---------------------------------------------------------------------------
# S-1.8 -- a missing service_account KEY_FILE gives a clear, actionable
# error (never an opaque failure, never key material).
# ---------------------------------------------------------------------------
statement error
CREATE SECRET gdrive_sa_missing (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '/nonexistent/path/does-not-exist-sa.json'
);
----
not found or not readable

# S-1.8 -- a KEY_FILE that exists but is not JSON at all gives a distinct
# message from "not found".
statement ok
COPY (SELECT 'this is not json') TO '{TEST_DIR}/gdrive_sa_not_json.txt' (FORMAT csv, HEADER false, QUOTE '');

statement error
CREATE SECRET gdrive_sa_not_json (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '{TEST_DIR}/gdrive_sa_not_json.txt'
);
----
not valid JSON

# S-1.8 -- valid JSON, but the common mistake of handing over an OAuth
# *client* JSON (has an "installed"/"web" wrapper) instead of a
# service-account key gets its own actionable message.
statement ok
COPY (SELECT '{"installed":{"client_id":"abc"}}') TO '{TEST_DIR}/gdrive_oauth_client.json' (FORMAT csv, HEADER false, QUOTE '');

statement error
CREATE SECRET gdrive_sa_oauth_client (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '{TEST_DIR}/gdrive_oauth_client.json'
);
----
OAuth *client* JSON

# S-1.8 -- valid JSON, correct shape, but missing client_email.
statement ok
COPY (SELECT '{"type":"service_account","private_key":"-----BEGIN PRIVATE KEY-----\nfake\n-----END PRIVATE KEY-----\n"}')
TO '{TEST_DIR}/gdrive_sa_no_email.json' (FORMAT csv, HEADER false, QUOTE '');

statement error
CREATE SECRET gdrive_sa_no_email (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '{TEST_DIR}/gdrive_sa_no_email.json'
);
----
client_email

# S-1.8 -- valid JSON, correct shape, but missing private_key.
statement ok
COPY (SELECT '{"type":"service_account","client_email":"sa@example.iam.gserviceaccount.com"}')
TO '{TEST_DIR}/gdrive_sa_no_key.json' (FORMAT csv, HEADER false, QUOTE '');

statement error
CREATE SECRET gdrive_sa_no_key (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '{TEST_DIR}/gdrive_sa_no_key.json'
);
----
private_key

# ---------------------------------------------------------------------------
# REQ-NF-03 -- none of the above error messages may ever quote key material.
# There is no key material in any of the fixtures above (the "private_key"
# case uses the literal string "fake", not a real key), which is itself part
# of the point: this test cannot accidentally leak anything real.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bug found on the first live run against real Drive (2026-07-26): DuckDB's
# CREATE SECRET grammar hard-codes "SCOPE" as the secret's PATH-matching
# prefix (CreateSecretInfo::scope, consumed by SecretManager::LookupSecret),
# not as a regular key-value option -- see
# duckdb/src/parser/peg/transformer/transform_create_secret.cpp. The OAuth
# scope option this extension exposes is named "drive_scope" specifically to
# avoid that collision. A secret created with a bare `SCOPE '...'` clause
# would silently have its PATH scope rescoped to that string instead -- never
# matching any gdrive:// path -- while `drive_scope` reaches the secret's
# key-value map exactly as any other option does. This is a regression test
# for the option landing where it should, not a network test: no Drive call
# happens here.
# ---------------------------------------------------------------------------
statement ok
CREATE SECRET gdrive_drive_scope (
    TYPE gdrive,
    PROVIDER config,
    ACCESS_TOKEN 'irrelevant-token',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive'
);

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_drive_scope' AND secret_string LIKE '%https://www.googleapis.com/auth/drive%'
----
1

# A plain `SCOPE '...'` clause is DuckDB's reserved path-scope clause (every
# secret type accepts it), not this extension's OAuth scope option: it must
# land in the secret's built-in path-scope field (`scope=gdrive://some/
# prefix` below), and drive_scope must fall back to its narrowest default
# since the drive_scope OPTION itself was never set by this clause.
statement ok
CREATE SECRET gdrive_path_scope (
    TYPE gdrive,
    PROVIDER config,
    ACCESS_TOKEN 'irrelevant-token-2',
    SCOPE 'gdrive://some/prefix'
);

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_path_scope' AND secret_string LIKE '%scope=gdrive://some/prefix%'
----
1

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_path_scope' AND secret_string LIKE '%drive_scope=https://www.googleapis.com/auth/drive.readonly%'
----
1

# ---------------------------------------------------------------------------
# C-1 -- the `authorization_code` provider EXISTS.
#
# This block previously pinned the provider as withdrawn, and said so: "if
# someone registers an in-process browser consent flow later, this test fails
# and forces them to update the README and the plan in the same change --
# which is the whole point of it existing." That is what happened. The README
# claim and `make verify_readme` were updated in the same commit.
#
# You bring your own OAuth client (D-9). There is no client id compiled into
# this extension, so nobody's consent screen says DataZoo and there is no
# Google verification dependency -- the cost is that CLIENT_ID and
# CLIENT_SECRET are required here.
#
# Creation stores configuration only. The browser flow runs on FIRST USE, not
# at CREATE SECRET: the same lazy pattern erpl-web uses, and the reason this
# statement can be asserted without a browser anywhere near it.
statement ok
CREATE SECRET gdrive_authcode (
    TYPE gdrive,
    PROVIDER authorization_code,
    CLIENT_ID 'my-client-id.apps.googleusercontent.com',
    CLIENT_SECRET 'super-secret-client-secret-value',
    DRIVE_SCOPE 'https://www.googleapis.com/auth/drive'
);

query I
SELECT provider FROM duckdb_secrets() WHERE name = 'gdrive_authcode'
----
authorization_code

# REQ-NF-03: the client secret must not survive into duckdb_secrets().
query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'gdrive_authcode'
  AND secret_string LIKE '%super-secret-client-secret-value%'
----
0

# Both halves of the client are required, and each is named on its own so the
# reader is told which one is missing rather than "invalid configuration".
statement error
CREATE SECRET gdrive_authcode_nocid (
    TYPE gdrive,
    PROVIDER authorization_code,
    CLIENT_SECRET 'x'
);
----
CLIENT_ID

statement error
CREATE SECRET gdrive_authcode_nosecret (
    TYPE gdrive,
    PROVIDER authorization_code,
    CLIENT_ID 'my-client-id.apps.googleusercontent.com'
);
----
CLIENT_SECRET

# The two providers that DO exist must still be creatable, so the assertion
# above cannot pass merely because provider registration is broken outright.
statement ok
CREATE OR REPLACE SECRET gdrive_provider_control (
    TYPE gdrive,
    PROVIDER config,
    ACCESS_TOKEN 'irrelevant-token-3'
);

# service_account validates its key file AT CREATE time, which is the right
# moment: the alternative is a secret that looks fine until the first query.
statement error
CREATE OR REPLACE SECRET gdrive_provider_control_sa (
    TYPE gdrive,
    PROVIDER service_account,
    KEY_FILE '/nonexistent/key.json'
);
----
/nonexistent/key.json
